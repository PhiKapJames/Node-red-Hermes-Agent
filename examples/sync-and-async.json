[
  {
    "id": "hermes-example-tab",
    "type": "tab",
    "label": "Hermes - generic sync and async",
    "disabled": true,
    "info": "Configure the shared connection credential before enabling. No application-specific routing is included."
  },
  {
    "id": "hermes-example-connection",
    "type": "hermes-connection",
    "name": "Example Hermes profile",
    "baseUrl": "http://127.0.0.1:8642",
    "profile": "",
    "apiKeyEnv": "HERMES_NODE_RED_API_KEY",
    "requestTimeout": 30
  },
  {
    "id": "hermes-example-queue",
    "type": "hermes-queue",
    "name": "One shared FIFO",
    "maxPending": 10,
    "cooldown": 0,
    "pollInterval": 5,
    "jobTimeout": 1200,
    "stopTimeout": 30,
    "retryDelay": 2,
    "startRetries": 2,
    "asyncRequestTimeout": 30
  },
  {
    "id": "hermes-example-async-inject",
    "type": "inject",
    "z": "hermes-example-tab",
    "name": "Test async",
    "props": [
      {
        "p": "payload",
        "vt": "json",
        "v": "{\"text\": \"Reply with a short greeting.\", \"userId\": \"example-client\", \"name\": \"Alex\"}"
      }
    ],
    "payload": "{\"text\": \"Reply with a short greeting.\", \"userId\": \"example-client\", \"name\": \"Alex\"}",
    "payloadType": "json",
    "once": false,
    "repeat": "",
    "crontab": "",
