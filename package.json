{
  "name": "node-red-contrib-hermes-agent",
  "version": "0.2.0",
  "description": "Transport-independent Node-RED 5+ Hermes Agent nodes: shared credentials, synchronous chat, asynchronous Runs, sessions and queue controls.",
  "license": "MIT",
  "main": "nodes/hermes.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "hermes-agent": "nodes/hermes.js"
    }
  },
  "files": [
    "nodes/",
    "lib/",
    "examples/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm run check:syntax && npm run lint",
    "prepack": "npm run check:syntax && npm test",
    "check:syntax": "node --check nodes/hermes.js && node --check lib/client.js && node --check lib/queue.js && node --check lib/request.js && node --check lib/errors.js",
    "lint": "node scripts/lint.cjs"
  },
  "keywords": [
    "node-red",
    "hermes-agent",
    "nousresearch",
    "agents",
    "async",
    "queue",
    "node-red-5"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhiKapJames/Node-red-Hermes-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/PhiKapJames/Node-red-Hermes-Agent/issues"
  },
  "homepage": "https://github.com/PhiKapJames/Node-red-Hermes-Agent#readme",
  "author": "PhiKapJames",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "16.5.0"
  }
}
